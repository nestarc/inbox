{
  "name": "@nestarc/inbox",
  "version": "0.2.0",
  "description": "Transactional inbox for NestJS, Prisma and PostgreSQL with durable deduplication, fenced processing and retries.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nestarc/inbox.git"
  },
  "homepage": "https://github.com/nestarc/inbox#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "require": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./sql/create-inbox-table.sql": "./src/sql/create-inbox-table.sql",
    "./sql/migrate-v1-to-v2.sql": "./src/sql/migrate-v1-to-v2.sql"
  },
  "files": [
    "dist",
    "src/sql",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "examples",
    "!examples/node_modules",
    "!examples/dist",
    "!examples/src/generated",
    "!examples/package-lock.json"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "prisma generate --config test/prisma/prisma.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:release": "node --test test/release/*.test.mjs",
    "test:integration": "node scripts/with-test-db.mjs npm run test:integration:run",
    "test:integration:run": "vitest run test/integration test/failure",
    "test:operations": "node scripts/with-test-db.mjs node node_modules/vitest/vitest.mjs run test/operations",
    "test:operations:database": "node scripts/test-db-operations.mjs",
    "test:broker-recovery": "node scripts/with-test-db.mjs node scripts/test-broker-recovery.mjs",
    "test:package": "node scripts/with-test-db.mjs node scripts/test-package.mjs",
    "test:examples": "node scripts/with-test-db.mjs node scripts/test-examples.mjs",
    "prebenchmark": "npm run build",
    "benchmark": "node scripts/with-test-db.mjs node scripts/benchmark.mjs",
    "benchmark:sustained": "node scripts/with-benchmark-db.mjs",
    "format": "prettier --write src test scripts .github/workflows README.md CHANGELOG.md docs/usage.md docs/releasing.md docs/testing.md package.json tsconfig*.json vitest.config.mts",
    "format:check": "prettier --check src test scripts .github/workflows README.md CHANGELOG.md docs/usage.md docs/releasing.md docs/testing.md package.json tsconfig*.json vitest.config.mts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@prisma/client": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@nestarc/tenancy": "^0.16.2"
  },
  "devDependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/testing": "11.2.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "prettier": "3.8.3",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "@nestarc/tenancy": "0.16.2"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "peerDependenciesMeta": {
    "@nestarc/tenancy": {
      "optional": true
    }
  },
  "workspaces": [
    "src/internal/reliability-core"
  ]
}
